{
  "name": "@workspace/backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "convex dev",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
