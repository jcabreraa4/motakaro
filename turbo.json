{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NEXT_RUNTIME", "CI"],
  "globalPassThroughEnv": ["TRIGGER_SECRET_KEY", "CONVEX_DEPLOY_KEY", "CLERK_SECRET_KEY", "TRIGGER_ACCESS_TOKEN", "TELEGRAM_BOT_USERNAME", "TELEGRAM_BOT_TOKEN", "CLERK_ADMINS_JWT_DOMAIN", "CLERK_CLIENTS_JWT_DOMAIN"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "format": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "deploy": {
      "cache": false
    },
    "//#knip": {
      "cache": false
    }
  }
}
