{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NEXT_RUNTIME", "CI", "CLERK_ADMINS_JWT_DOMAIN", "CLERK_CLIENTS_JWT_DOMAIN"],
  "globalPassThroughEnv": [
    // System
    "CORS_ORIGINS",

    // Clerk
    "CLERK_SECRET_KEY",
    "CLERK_PUBLISHABLE_KEY",

    // Trigger
    "TRIGGER_SECRET_KEY",

    // OpenRouter
    "OPENROUTER_API_KEY",
    "OPENROUTER_MODEL",

    "OPENROUTER_CONTEXT",
    "OPENROUTER_REASONING"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "format": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "eval": {
      "cache": false,
      "dependsOn": ["typecheck"]
    },
    "//#knip": {
      "cache": false
    }
  }
}
