{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "version": "0.1.1",
  "productName": "Motakaro",
  "mainBinaryName": "motakaro",
  "identifier": "com.motakaro.clients",
  "build": {
    "frontendDist": "https://app.motakaro.com"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Motakaro",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Motakaro",
        "url": "motakarosplash://localhost/index.html",
        "width": 400,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "center": true,
        "focus": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "shortDescription": "Motakaro client portal",
    "longDescription": "Desktop app for the Motakaro client portal.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
