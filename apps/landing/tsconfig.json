{
  "extends": "@workspace/typescript-config/next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/backend/*": ["../../packages/backend/convex/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", "**/*.mts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
