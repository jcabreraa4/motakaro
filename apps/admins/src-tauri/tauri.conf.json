{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "version": "0.1.0",
  "productName": "Motakaro Admins",
  "mainBinaryName": "motakaro-admins",
  "identifier": "com.motakaro.admins",
  "build": {
    "frontendDist": "https://admins.motakaro.com"
  },
  "app": {
    "windows": [
      {
        "title": "Motakaro",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
