{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/backend/*": ["../../packages/backend/convex/*"],
      "@workspace/render/*": ["../../packages/render/src/*"],
      "@workspace/tiptap/*": ["../../packages/tiptap/src/*"],
      "@workspace/trigger/*": ["../../packages/trigger/src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", "**/*.mts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
